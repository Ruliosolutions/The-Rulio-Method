# =============================================================================
# Rulio Engine — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Stripe — https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
# Get this from https://dashboard.stripe.com/apikeys
# Starts with sk_test_ (development) or sk_live_ (production)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Get this from https://dashboard.stripe.com/webhooks after adding the endpoint
# Starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# These are filled in by `npm run setup:stripe:all` — leave blank initially
STRIPE_PRICE_WORKSHOP_STANDARD=
STRIPE_PRICE_WORKSHOP_BOOK=
STRIPE_PRICE_WORKSHOP_BUNDLE=
STRIPE_PRICE_ENGINE_PRO_MONTHLY=
STRIPE_PRICE_ENGINE_PRO_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=

# -----------------------------------------------------------------------------
# Supabase — https://app.supabase.com/project/_/settings/api
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co

# Anon (public) key — safe to ship to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# Service role key — SERVER ONLY. Never expose to the browser.
# Get from Settings → API → service_role (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# -----------------------------------------------------------------------------
# Resend — https://resend.com/api-keys
# -----------------------------------------------------------------------------
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_REPLACE_ME

# Verified sending domains (set these up in Resend dashboard)
# e.g. workshop@rulio.io, audit@rulio.io, engine@rulio.io

# -----------------------------------------------------------------------------
# Public URL
# -----------------------------------------------------------------------------
# Used for Stripe success_url / cancel_url
# Dev: http://localhost:3000
# Prod: https://rulio.app
NEXT_PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Cron protection (optional but recommended in production)
# -----------------------------------------------------------------------------
# Random 32+ char string. Send as `Authorization: Bearer <CRON_SECRET>` from
# your cron provider (cron-job.org, Vercel Cron, GitHub Actions, etc.)
CRON_SECRET=

# -----------------------------------------------------------------------------
# Workshop logistics
# -----------------------------------------------------------------------------
# Zoom link sent in the confirmation email
WORKSHOP_ZOOM_LINK=https://rulio.zoom.us/j/REPLACE_ME

# Replay + asset URLs sent in the post-workshop email
WORKSHOP_REPLAY_URL=https://rulio.io/workshop/replay
WORKSHOP_CARDS_URL=https://rulio.io/assets/9-frequency-cards.pdf
WORKSHOP_LOG_URL=https://rulio.io/assets/7-day-log.pdf

# Calendly URL for the free Energy Audit
CALENDLY_AUDIT_URL=https://calendly.com/rulio/energy-audit
