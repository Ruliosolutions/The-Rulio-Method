# =============================================================================
# Rulio Engine — production env template
# =============================================================================
# Copy to .env.local and fill in. NEVER commit .env.local.
# All values below are PLACEHOLDERS — fill in your own.
# Re-run npm run setup:stripe:all after filling to refresh Stripe price IDs.
# =============================================================================

# -----------------------------------------------------------------------------
# Stripe — https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
# Test mode secret (for development). Get from Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Live mode secret (for production only). NEVER commit your live key.
STRIPE_SECRET_KEY_LIVE=sk_live_REPLACE_ME

# Webhook signing secret (set in Stripe Dashboard → Webhooks → your endpoint)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Stripe price IDs (filled in by `npm run setup:stripe:all`)
STRIPE_PRICE_WORKSHOP_STANDARD=price_REPLACE_ME
STRIPE_PRICE_WORKSHOP_BOOK=price_REPLACE_ME
STRIPE_PRICE_WORKSHOP_BUNDLE=price_REPLACE_ME
STRIPE_PRICE_ENGINE_PRO_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_ENGINE_PRO_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_STUDIO_MONTHLY=price_REPLACE_ME

# -----------------------------------------------------------------------------
# Supabase — https://app.supabase.com/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
# Optional new-format names
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_JWKS_URL=https://REPLACE_ME.supabase.co/auth/v1/.well-known/jwks.json

# -----------------------------------------------------------------------------
# Resend — https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_REPLACE_ME

# -----------------------------------------------------------------------------
# PostHog (EU) — https://eu.posthog.com
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=phc_REPLACE_ME
POSTHOG_HOST=https://eu.i.posthog.com

# -----------------------------------------------------------------------------
# App config
# -----------------------------------------------------------------------------
# Production URL — update after deploy
NEXT_PUBLIC_URL=https://rulio.engine

# Random 32+ char string for cron auth
# Generate: openssl rand -hex 32
CRON_SECRET=REPLACE_ME_WITH_32_CHAR_RANDOM_HEX

# -----------------------------------------------------------------------------
# Workshop + Audit
# -----------------------------------------------------------------------------
WORKSHOP_ZOOM_LINK=https://rulio.zoom.us/j/REPLACE_ME
WORKSHOP_REPLAY_URL=https://rulio.io/workshop/replay
WORKSHOP_CARDS_URL=https://rulio.io/assets/9-frequency-cards.pdf
WORKSHOP_LOG_URL=https://rulio.io/assets/7-day-log.pdf
CALENDLY_AUDIT_URL=https://calendly.com/REPLACE_ME/energy-audit

# =============================================================================
# ⚠️  NEVER commit real values to this file. The .example extension lets it
#     be tracked in git, but real secrets belong in .env.local (gitignored)
#     or in your hosting provider's secret manager (Vercel/Render/Fly).
# =============================================================================
